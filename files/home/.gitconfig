[user]
	name = Nate Berkopec
	email = nate.berkopec@gmail.com
	signingkey = C85159D1D1496A315A7E01466BF45F815F702663
[push]
  default = simple
        followTags = true
	autoSetupRemote = true
[github]
  user = nateberkopec
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        required = true
        process = git-lfs filter-process
[color]
        ui = true
[alias]
        commend = commit --amend --no-edit
        co-main = "!f() { \
                branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@'); \
                if [ -z \"$branch\" ]; then \
                    for b in main master staging develop; do \
                        if git show-ref --verify --quiet refs/heads/$b; then \
                            branch=$b; \
                            break; \
                        fi; \
                    done; \
                fi; \
                if [ -z \"$branch\" ]; then \
                    echo 'No main branch found'; \
                    exit 1; \
                fi; \
                git checkout $branch; \
            }; f"
        co = checkout
[core]
        excludesfile = ~/.gitignore
	editor = code -w
	hooksPath = ~/.git-hooks
[pull]
        rebase = false
[init]
        defaultBranch = main
[branch]
	sort = -committerdate
[commit]
	gpgsign = true
[gpg]
	program = gpg
[diff]
        external = difft
[hook "ai-assisted"]
	command = ~/.local/bin/ai-assisted-trailer
	event = commit-msg
[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run commit-msg --from-hook
	event = commit-msg
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-commit --from-hook --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-push --from-hook
	event = pre-push
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run prepare-commit-msg --from-hook
	event = prepare-commit-msg
[include]
	path = ~/.gitconfig.local
