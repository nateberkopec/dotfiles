{
  "lastChangelogVersion": "9999.0.0",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-mcp-adapter@4.0.0",
    "git:github.com/nateberkopec/pi-fast-mode@6f8605ece71922bc7ff27fdb9333949e9b609afd",
    "npm:pi-subagents@0.75.0",
    "npm:pi-intercom@0.16.0",
    "git:github.com/nateberkopec/pi-openai-guidance@3b48d10fe51b3108edc6fd8b0ec77a2731ebe15e",
    "npm:pi-context-view@0.6.0",
    {
      "source": "git:github.com/nateberkopec/agent-stuff@c89714b8d7ab98a0646f84878bec5eaf0af9170c",
      "extensions": ["extensions/goal.ts", "extensions/answer.ts"],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "extensions": [
    "-builtin:mcp",
    "-extensions/herdr-agent-state.ts"
  ],
  "npmCommand": ["bash", "-c", "exec bash \"$HOME/.pi/agent/pi-npm.sh\" \"$@\"", "npm"],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "openai/gpt-6-astra:low",
    "openai/gpt-6-luna:xhigh",
    "fireworks/accounts/fireworks/routers/kimi-k3-us",
    "meridian/claude-opus-5-5",
    "meridian/claude-fable-5-1"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "theme": "dark"
}
