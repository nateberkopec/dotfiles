{
  "lastChangelogVersion": "0.80.9",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-mcp-adapter@2.32.1",
    "npm:@narumitw/pi-btw@0.56.2",
    "git:github.com/nijaru/pi-fast-mode@85c8b67a4a3f823e33ab0217a55f37d15e6e6eca",
    "git:github.com/nateberkopec/pi-ding@af4d8fbe67f2aff9cebcee31f30a6b0eb69ba8c4",
    "npm:pi-subagents@0.64.0",
    "npm:pi-web-providers@3.5.1",
    "git:github.com/nateberkopec/pi-openai-guidance@b9e9507ece945fc1dd71d1e838a75fe794576d83",
    "npm:pi-context-view@0.6.0"
  ],
  "npmCommand": [
    "mise",
    "exec",
    "node",
    "--",
    "npm"
  ],
  "ding": {
    "enabled": true
  },
  "enabledModels": [
    "openai-codex/gpt-6-sol:medium",
    "openai-codex/gpt-6-astra:low",
    "openai-codex/gpt-5.6-sol:medium",
    "openai-codex/gpt-5.6-luna:xhigh",
    "meridian/claude-*"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "theme": "dark"
}
