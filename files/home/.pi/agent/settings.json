{
  "lastChangelogVersion": "9999.0.0",
  "defaultProvider": "claude-code",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "ask",
  "hideThinkingBlock": false,
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    {
      "source": "git:github.com/nateberkopec/agent-stuff@2a356dd950e77185947374f4c4f9fbe218b13a4e",
      "skills": []
    },
    "git:github.com/nateberkopec/pi-claude-code@601eca48ee92f3e1204c75db83a6ae2c0d644eb9",
    "npm:pi-mcp-adapter@7.0.0",
    "npm:pi-subagents@0.83.0",
    "npm:pi-intercom@0.18.1",
    "npm:pi-context-view@0.8.0"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "npmCommand": [
    "bash",
    "-c",
    "exec bash \"$HOME/.pi/agent/pi-npm.sh\" \"$@\"",
    "npm"
  ],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "openai/gpt-6-astra:low",
    "openai/gpt-6-luna:xhigh",
    "openai/gpt-6.1-terra:medium",
    "vercel-ai-gateway/deepseek/deepseek-v4.1-flash-1017",
    "claude-code/claude-opus-5-5",
    "claude-code/claude-fable-5-1"
  ],
  "subagents": {
    "defaultSubagentOnlyExtensions": ["~/.pi/agent/npm/node_modules/pi-mcp-adapter/index.ts"],
    "agentOverrides": {
      "delegate": {
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor", "mcp"],
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "tools": ["read", "grep", "find", "ls", "bash", "mcp"],
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "tools": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor", "mcp"],
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor", "mcp"],
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "theme": "dark"
}
