{
  "lastChangelogVersion": "9999.0.0",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-mcp-adapter@2.37.0",
    "npm:@narumitw/pi-btw@0.61.0",
    "git:github.com/nateberkopec/pi-fast-mode@6f8605ece71922bc7ff27fdb9333949e9b609afd",
    "npm:pi-subagents@0.75.0",
    "npm:pi-web-providers@3.5.1",
    "git:github.com/nateberkopec/pi-openai-guidance@b9e9507ece945fc1dd71d1e838a75fe794576d83",
    "npm:pi-context-view@0.6.0",
    {
      "source": "git:github.com/mitsuhiko/agent-stuff@0865c849befd2021490679f96a8dee58c84ac857",
      "extensions": ["extensions/goal.ts", "extensions/answer.ts"],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "npmCommand": [
    "mise",
    "exec",
    "node",
    "--",
    "npm"
  ],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "openai/gpt-6-astra:low",
    "openai/gpt-6-luna:xhigh",
    "fireworks/accounts/fireworks/routers/kimi-k3-us",
    "meridian/claude-opus-5-5",
    "meridian/claude-fable-5-1"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "theme": "dark"
}
