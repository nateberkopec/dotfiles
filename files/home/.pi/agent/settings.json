{
  "lastChangelogVersion": "9999.0.0",
  "defaultProvider": "meridian",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "httpIdleTimeoutMs": 120000,
  "hideThinkingBlock": false,
  "packages": [
    {
      "source": "git:github.com/nateberkopec/agent-stuff@main",
      "skills": []
    },
    "npm:@nateberkopec/pi-meridian@0.1.0-beta.2",
    "npm:pi-mcp-adapter@5.4.0",
    "npm:pi-subagents@0.81.0",
    "npm:pi-intercom@0.18.1",
    "npm:pi-context-view@0.7.2"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "npmCommand": [
    "bash",
    "-c",
    "exec bash \"$HOME/.pi/agent/pi-npm.sh\" \"$@\"",
    "npm"
  ],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "openai/gpt-6-astra:low",
    "openai/gpt-6-luna:xhigh",
    "fireworks/accounts/fireworks/routers/kimi-k3-us",
    "meridian/claude-opus-5-5",
    "meridian/claude-fable-5-1"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "theme": "dark"
}
