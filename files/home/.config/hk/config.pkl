amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

fail_fast = false

local checks = new Mapping<String, Step> {
  ["lint"] {
    check = "mise run lint"
  }
  ["test"] {
    check = "mise run test"
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["ai-assisted"] {
        check = "~/.local/bin/ai-assisted-trailer {{commit_msg_file}}"
      }
    }
  }
  ["pre-commit"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
