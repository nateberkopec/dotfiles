amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

fail_fast = false

local function tailOnFailure(name: String, command: String): String =
  #"log="$(git rev-parse --git-dir)/hk/\#(name).log"; mkdir -p "${log%/*}"; \#(command) > "$log" 2>&1 || { tail -n 40 "$log"; echo "Full output: $log"; exit 1; }"#

local checks = new Mapping<String, Step> {
  ["lint"] {
    check = tailOnFailure("lint", "mise run lint")
  }
  ["test"] {
    check = tailOnFailure("test", "mise run test")
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["ai-assisted"] {
        check = "test ! -x ~/.git-hooks/commit-msg || ~/.git-hooks/commit-msg {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
