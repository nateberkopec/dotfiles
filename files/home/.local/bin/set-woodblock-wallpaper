#!/usr/bin/env fish

set -gx PATH "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.homebrew/bin" /opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin $PATH

set -l private_fish "$HOME/.config/fish/private.fish"
if test -f "$private_fish"
  source "$private_fish"
end

if not set -q UNSPLASH_ACCESS_KEY
  echo "UNSPLASH_ACCESS_KEY must be set, for example in ~/.config/fish/private.fish" >&2
  exit 1
end

if not command -q woodblock
  echo "woodblock command not found; run dotf run to install dependencies" >&2
  exit 1
end

woodblock next
