#!/bin/bash

set -e

BOOTSTRAP_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(dirname "$BOOTSTRAP_DIR")"
# shellcheck source=lib/dotf-common.sh
source "$BOOTSTRAP_DIR/lib/dotf-common.sh"

is_macos() {
    [ "$(uname -s)" = "Darwin" ]
}

is_linux() {
    [ "$(uname -s)" = "Linux" ]
}

debug() {
    if [ "${DEBUG:-false}" = "true" ]; then
        timestamp=$(dotf_date '%H:%M:%S.%3N' '%H:%M:%S')
        echo "[$timestamp] $1"
    fi
}

private_homebrew_prefix() {
    printf '%s\n' "$HOME/.homebrew"
}

private_homebrew_bin() {
    printf '%s\n' "$(private_homebrew_prefix)/bin/brew"
}

user_has_admin_rights() {
    id -Gn | tr ' ' '\n' | grep -qx admin
}

resolve_homebrew_bin() {
    if command -v brew &> /dev/null; then
        command -v brew
    elif [ -x /opt/homebrew/bin/brew ]; then
        printf '%s\n' "/opt/homebrew/bin/brew"
    elif [ -x /usr/local/bin/brew ]; then
        printf '%s\n' "/usr/local/bin/brew"
    fi
}

install_private_homebrew() {
    local prefix
    prefix="$(private_homebrew_prefix)"

    debug "Installing private Homebrew to ${prefix}..."
    mkdir -p "$(dirname "$prefix")"
    if [ -d "$prefix/.git" ]; then
        debug "Private Homebrew repository already present"
    else
        git clone --depth=1 https://github.com/Homebrew/brew "$prefix"
    fi
    mkdir -p "$prefix/Cellar" "$prefix/Caskroom" "$HOME/Library/Caches/Homebrew"
}

configure_homebrew_shellenv() {
    local brew_bin="$1"
    local zprofile_path="$HOME/.zprofile"
    local shellenv_line
    shellenv_line="$(printf 'eval \"$(%s shellenv)\"' "$brew_bin")"

    if ! grep -Fq "$shellenv_line" "$zprofile_path" 2>/dev/null; then
        printf '%s\n' "$shellenv_line" >> "$zprofile_path"
    fi

    eval "$("$brew_bin" shellenv -s bash)"
}

install_homebrew() {
    local install_script
    install_script="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    if should_install_homebrew_noninteractively; then
        NONINTERACTIVE=1 /bin/bash -c "$install_script"
    else
        /bin/bash -c "$install_script"
    fi
}

should_install_homebrew_noninteractively() {
    [ -n "${CI:-}" ] || [ -n "${NONINTERACTIVE:-}" ] || ! has_terminal
}

has_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

ensure_dotfiles_checkout() {
    local target="$HOME/.dotfiles"

    if [ "$DOTFILES_ROOT" = "$target" ] || [ -e "$target" ] || [ -L "$target" ]; then
        return
    fi

    ln -s "$DOTFILES_ROOT" "$target"
}

bootstrap_homebrew() {
    if ! is_macos; then
        return 0
    fi

    local brew_bin=""

    if user_has_admin_rights; then
        if ! command -v brew &> /dev/null; then
            debug "Installing Homebrew..."
            install_homebrew
        fi
        brew_bin="$(resolve_homebrew_bin)"
    else
        if [ ! -x "$(private_homebrew_bin)" ]; then
            install_private_homebrew
        fi
        brew_bin="$(private_homebrew_bin)"
    fi

    if [ -z "$brew_bin" ] || [ ! -x "$brew_bin" ]; then
        echo "Error: Homebrew installation completed but 'brew' was not found"
        exit 1
    fi

    configure_homebrew_shellenv "$brew_bin"
}

ensure_debian_apt_source() {
    local name="$1"
    local key_url="$2"
    local source_line="$3"
    local keyring_dir="${DEBIAN_KEYRING_DIR:-/usr/share/keyrings}"
    local source_dir="${DEBIAN_SOURCE_DIR:-/etc/apt/sources.list.d}"
    local keyring_path="$keyring_dir/${name}-archive-keyring.gpg"
    local source_path="$source_dir/${name}.list"

    if [ ! -f "$keyring_path" ]; then
        local key_file
        key_file="$(mktemp)"
        curl -fsSL "$key_url" -o "$key_file"
        sudo gpg --dearmor -o "$keyring_path" "$key_file"
        rm -f "$key_file"
    fi

    if ! grep -Fxq "$source_line" "$source_path" 2>/dev/null; then
        printf '%s\n' "$source_line" | sudo tee "$source_path" >/dev/null
    fi
}

prepare_debian_apt_sources() {
    ensure_debian_apt_source "gierens" "https://raw.githubusercontent.com/eza-community/eza/main/deb.asc" \
        "deb [signed-by=/usr/share/keyrings/gierens-archive-keyring.gpg] http://deb.gierens.de stable main"
}

remove_mise_apt_source() {
    sudo rm -f \
        /etc/apt/sources.list.d/mise.list \
        /etc/apt/sources.list.d/mise.sources \
        /usr/share/keyrings/mise-archive-keyring.gpg
}

bootstrap_debian_prereqs() {
    if ! is_linux; then
        return 0
    fi

    debug "Installing Debian prerequisites..."
    remove_mise_apt_source
    sudo apt-get update -y
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        git \
        gnupg \
        unzip \
        xz-utils
    prepare_debian_apt_sources
}

MISE_BOOTSTRAP_VERSION="2026.8.0"

mise_version() {
    "$1" --version 2>/dev/null | awk 'NR == 1 { print $1 }'
}

mise_install_version() {
    local version="$MISE_BOOTSTRAP_VERSION"
    local existing_version

    if command -v mise &> /dev/null; then
        existing_version="$(mise_version "$(command -v mise)")"
        if [ -n "$existing_version" ] && dotf_version_is_newer "$existing_version" "$version"; then
            version="$existing_version"
        fi
    fi
    printf '%s\n' "$version"
}

install_self_managed_mise() {
    local mise_bin="$HOME/.local/bin/mise"
    local version
    version="$(mise_install_version)"

    debug "Installing mise ${version} to ${mise_bin}..."
    curl -fsSL https://mise.run | MISE_VERSION="$version" MISE_INSTALL_PATH="$mise_bin" sh
}

bootstrap_mise() {
    local mise_bin="$HOME/.local/bin/mise"

    if [ ! -x "$mise_bin" ] || ! "$mise_bin" --version >/dev/null 2>&1; then
        install_self_managed_mise
    else
        debug "Self-managed mise already installed"
    fi

    export PATH="$HOME/.local/bin:$PATH"
    hash -r
    if ! "$mise_bin" --version >/dev/null 2>&1; then
        echo "Error: mise installation at ${mise_bin} could not be verified" >&2
        return 1
    fi

    seed_global_mise_config

    # Trust mise config in current directory (needed for non-interactive environments)
    if [ -f ".mise.toml" ]; then
        debug "Trusting mise config..."
        if [ "${DEBUG:-false}" = "true" ]; then
            mise trust --yes || true
        else
            mise trust --yes 2>/dev/null || true
        fi
    fi

    eval "$(mise activate bash)"
}

seed_global_mise_config() {
    debug "Seeding global mise config from the repo..."
    mkdir -p "$HOME/.config/mise"
    cp "$DOTFILES_ROOT/files/home/.config/mise/config.toml" "$HOME/.config/mise/config.toml"
}

main() {
    ensure_dotfiles_checkout
    debug "Bootstrapping development environment..."

    bootstrap_homebrew
    bootstrap_debian_prereqs
    bootstrap_mise

    debug "Bootstrap complete."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
