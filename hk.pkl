amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["secrets"] {
    check = "mise run lint:secrets"
  }
}

hooks {
  ["pre-commit"] {
    steps = (checks) {
      ["human-only"] {
        check = "mise run lint:human-only"
      }
    }
  }
  ["check"] {
    steps = checks
  }
}
